# ==============================================================================
# MARINA INTELLIGENCE: Environment Configuration
# ==============================================================================

PROJECT_NAME="MARINA INTELLIGENCE"
VERSION="0.1.0"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security (Change in Production)
SECRET_KEY="marina-intelligence-change-this-secret-key-in-production-2026"

# ------------------------------------------------------------------------------
# Database Configurations:
# ------------------------------------------------------------------------------
# Option A (Production / Docker): PostgreSQL with async psycopg driver
DATABASE_URL="postgresql+psycopg://marina:marina_secret@localhost:5432/marina_intelligence"

# Option B (Local Windows Offline / Test): SQLite with async aiosqlite driver
# DATABASE_URL="sqlite+aiosqlite:///D:/MARINA INTELLIGENCE/backend/marina.db"

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=marina
POSTGRES_PASSWORD=marina_secret
POSTGRES_DB=marina_intelligence
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Football Context Defaults
# ------------------------------------------------------------------------------
DEFAULT_CLUB_CODE="CFC"
DEFAULT_CLUB_NAME="Chennaiyin FC"
DEFAULT_SEASON_CODE="2026–27"
DEFAULT_COMPETITION_CODE="ISL"

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
